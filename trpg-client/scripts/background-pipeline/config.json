  "最高优先级": "画面中不要出现任何人物。包括但不限于：主角、路人、人群、背影、侧影、人形剪影、舞台上的表演者、观众、顾客、摊贩、商旅、士卒、僧道。这是一张供游戏叠加人物立绘与对话框的无人的空景背景，出现任何人物都算失败。神像、塑像等宗教造像不在此限。",
  "固定要求": [
    "1920×1080 横构图，16:9。",
    "横向中远景，镜头高度大致与人眼齐平。",
    "画面中央与中下部不要放置巨大抢镜主体，为人物立绘和对话框留出空间。",
    "空间层次清楚，前景、主体、背景三层可辨。",
    "表现该设施最有辨识度的建筑结构、陈设、器具、货物与使用痕迹。",
    "靠凌乱的器物、散落的工具、半开的门窗、未收的坐席等细节体现「刚还有人用过」，而不是靠画人。",
    "牌匾、招牌、灯笼、幡旗上的文字一律留空，画面中不要出现任何可读文字。",
    "不要出现 UI、水印、签名、边框。"
  ],
  "禁止项": [
    "任何人物、人形剪影、背影、人群、人像画或屏风人物图",
    "活动物（马、牛、犬、猫、鸡、鸟等）；摊上或筐里的鱼、肉等货物不在此限",
    "镜面反射、金属反光、高光闪斑、湿亮地面、过强水面倒影",
    "镜头光晕、bloom、色差、滥用体积光",
    "摄影写实、3D 渲染、塑料感、油腻厚涂",
    "现代物品、电线、玻璃幕墙、霓虹灯",
    "任何可读文字，含牌匾、招牌、灯笼、幡旗、书本、告示、印章",
    "UI、水印、签名、边框、分割线",
    "过曝、死黑、大面积纯黑压暗"
  ],
  "美术风格": "延续中国古风武侠游戏的二维手绘数字背景：清晰而克制的深色勾线，半写实结构，略带动画背景感，柔和笔触，低到中等饱和度的土色、木色与矿物色，画面干净、层次清楚，具有南宋市井生活质感。风格向参考图靠拢，不要改变画风。",
  "光照与材质": "全部材质统一使用哑光表现。禁止镜面反射、金属反光、高光闪斑、湿亮地面、水面倒影过强、镜头光晕、bloom、色差和体积光滥用。光照以柔和漫射为主，阴影边缘偏软，不要过曝。",
  "period_rules": {
    "白天": "白天版本：以自然天光照明，日光柔和、方向明确但不过曝；室内靠门窗自然采光，加少量柔和的暖色补充；所有材质保持哑光。",
    "黑夜": "黑夜版本：严格沿用白天成品图的镜头位置、透视、建筑结构、家具陈设与整体构图，只改光照与活动状态。以低照度月光与少量灯笼、烛火提供柔和漫射照明；暗部仍要保留可读细节；禁止油亮反光和大面积橙色光污染。同样不得出现任何人物，夜间场景也要保持无人的空景。"
  },
  "夜间构图继承提示": "首要参考是你上一步为同一个 kind 生成的白天成品图。先出白天图，再出黑夜图；生成时保持白天图的机位、透视、建筑结构、主要家具与物件位置完全一致，只替换为夜间光照、灯火与相应的活动状态。",
  "zone_text": {
    "core": "位于南宋城市中心的繁华地带，周边是密集的街市与坊巷。",
    "water": "位于江河、湖泊或运河沿岸，水运便利。",
    "edge": "位于城郊、城防边缘或乡野，周边人口与建筑密度较低。",
    "general": "位于普通城市街坊或通用区域。"
  },
  "参考图通用说明": "参考图只用于对齐画风、勾线、配色、镜头高度、建筑结构与陈设密度；若参考图中出现人物、人群或人形剪影，请完全忽略，不要复制到成品里。成品必须是无人空景。",
  "reference_roles": [
    "主要风格与构图基准：优先对齐它的画风、勾线、配色、镜头高度和空间密度。",
    "同类场景的空间结构与陈设密度参考。",
    "细节与器具质感参考。",
    "色彩关系与光照氛围参考。",
    "补充参考。",
    "补充参考。"
  ],
  "kind_core_overrides": {
    "蓐收庙": "金神主题，富丽庄严的蓐收神庙，大量精工镀金装饰、金色礼器与秋金意象",
    "后土庙": "土神主题，大气庄严的正式神庙，黄土色石坛与大地礼制意象"
  },
  "kind_scene_focus": {
    "蓐收庙": "这是供奉金神蓐收的正式神庙，陈设要丰富、精致、有层次，不要显得空旷简陋。必须突出大量黄金与镀金装饰：梁柱、斗拱、神龛、门扇、栏杆与神台都带有金色包边、精细金属雕花与云雷纹饰；供案上陈列多件金色祭器、香炉、灯盏、花觚与整套礼器；神像、神龛与幡帐也用金色收边。主色调为白金色与铜金色，配深色木构和秋色（枯黄、赭红）点缀，表现肃杀的秋金之气。金属用哑光镀金和刻纹表现，金色装饰要清晰可见、分布密集，但避免镜面反光与刺眼高光。",
    "后土庙": "这是供奉土神后土的正式神庙，不是乡村小庙：建筑规模庄严、规制完整，呈现城镇重要祭祀场所的气派。中轴线上设正殿与门庭，殿前是抬高的石基平台与成对石阶，殿内有庄重的土神神像、石制祭坛、成套礼器与长条供案，梁下悬挂素色帷幔，地面铺厚重的青砖与石板。以黄土、赤褐、灰石为主色，突出厚重、安稳、古老、根植大地的神庙气质。不要出现农舍、农具、畜棚、田间小祠、茅草棚屋一类乡村生活元素，也不要画成路边土地庙那种低矮小龛。"
  },
